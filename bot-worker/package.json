{
  "name": "zeroclutter-bot-worker",
  "version": "1.0.0",
  "description": "Self-hosted meeting bot worker: joins Google Meet via Playwright",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "tsc --noEmit",
    "google:login": "ts-node src/google-login.ts",
    "prisma:generate": "node -e \"const fs=require('fs');fs.mkdirSync('prisma',{recursive:true});fs.copyFileSync('../backend/prisma/schema.prisma','prisma/schema.prisma')\" && prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.0",
    "playwright": "^1.49.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
