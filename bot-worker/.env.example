# Must point to the SAME PostgreSQL database as the backend
DATABASE_URL=postgresql://user:pass@localhost:5432/zeroclutter

# Must point to the SAME Redis instance as the backend
REDIS_URL=redis://localhost:6379

# Display name the bot uses when it has none of its own
BOT_DEFAULT_NAME=ZeroClutter Notetaker

# Timeouts (milliseconds)
NAV_TIMEOUT_MS=30000
ADMISSION_TIMEOUT_MS=300000
IN_CALL_POLL_MS=2000

# Set to "false" to watch the browser during local debugging
HEADLESS=true

# Google identity: guest | account | hybrid (default hybrid)
# - guest: unsigned named guest only
# - account: authenticated join only (requires storage state below)
# - hybrid: guest first, one authenticated retry when Meet requires sign-in or blocks guests
GOOGLE_AUTH_MODE=hybrid

# Playwright storage state written by `npm run google:login` — a credential; never commit
GOOGLE_STORAGE_STATE_PATH=.auth/google-state.json

# Dedicated bot account email (status/UI only); set before running google:login
GOOGLE_BOT_EMAIL=
