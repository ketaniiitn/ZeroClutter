# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/hintro"

# Redis (optional — caching and Redis-backed rate limiting; omit to use in-memory fallback)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Candidate Info (for /api/evaluation endpoint)
CANDIDATE_NAME=user123
CANDIDATE_EMAIL=xyz@gmail.com
REPOSITORY_URL=https://github.com/yourusername/hintro-meeting-intelligence
DEPLOYED_URL=https://your-deployed-url.onrender.com
