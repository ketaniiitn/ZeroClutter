# Application
NODE_ENV=development
PORT=3000

# Frontend origin — used for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/zeroclutter"

# Redis (optional — caching and Redis-backed rate limiting; omit for in-memory fallback)
REDIS_URL=redis://localhost:6379

# JWT signing secret — minimum 32 characters, use: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Google OAuth (optional — email/password auth works without these)
# Set up at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Candidate Info (for /api/evaluation endpoint)
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
REPOSITORY_URL=https://github.com/yourusername/zeroclutter
DEPLOYED_URL=https://your-deployed-url.com
