    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "meeting",
    "intelligence",
    "ai",
    "backend"
  ],
  "author": "Vyhm Dwivedi",
  "license": "MIT",
